# YUKI ENVIRONMENT VARIABLES TEMPLATE
# Copie este arquivo para .env para configurar seu ambiente local.
# O arquivo .env é estritamente ignorado pelo Git (.gitignore).

# Ambiente de execução
YUKI_ENV=development

# Configurações do Runtime
YUKI_CONFIG_PATH=config/yuki.toml
YUKI_REQUEST_TIMEOUT_MS=30000

# Observabilidade
YUKI_LOG_LEVEL=info
YUKI_LOG_FORMAT=text

# Persistência Local (Marco 3)
YUKI_DATABASE_PATH=data/yuki.db
YUKI_SQLITE_SYNCHRONOUS=NORMAL

# Provedor de Modelo (Marco 2)
YUKI_MODEL_PROVIDER=mock
YUKI_MODEL_ID=mock-v1

# Chave de API Externa (Marco 2 - Apenas quando YUKI_MODEL_PROVIDER=gemini)
# NUNCA cometa sua chave real no Git!
YUKI_GEMINI_API_KEY=
